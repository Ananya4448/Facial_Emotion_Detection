# ============================================
# FACIAL EMOTION DETECTION - ENVIRONMENT CONFIG
# ============================================
# Copy this file to .env and configure your settings
# Command: cp .env.example .env (Linux/Mac) or copy .env.example .env (Windows)

# ============================================
# MODEL CONFIGURATION
# ============================================

# Path to the trained model file
MODEL_PATH=best_model.h5

# Image size for model input (default: 48x48 for FER-2013)
PICTURE_SIZE=48

# Batch size for training
BATCH_SIZE=128

# Number of training epochs
EPOCHS=50

# Learning rate for optimizer
LEARNING_RATE=0.0001

# Optimizer type (adam, sgd, rmsprop)
OPTIMIZER=adam

# ============================================
# FACE DETECTION CONFIGURATION
# ============================================

# Path to Haar Cascade XML file for face detection
HAAR_CASCADE_PATH=haarcascade_frontalface_default.xml

# Haar Cascade download URL (default OpenCV repository)
HAAR_CASCADE_URL=https://raw.githubusercontent.com/opencv/opencv/master/data/haarcascades/haarcascade_frontalface_default.xml

# ============================================
# DATASET CONFIGURATION
# ============================================

# Path to training images folder
TRAIN_DATA_PATH=Training/images/train

# Path to validation images folder
VALIDATION_DATA_PATH=Training/images/validation

# Emotion labels (comma-separated)
EMOTION_LABELS=angry,disgust,fear,sad,happy,neutral,surprise

# Number of emotion classes
NUM_CLASSES=7

# ============================================
# WEBCAM CONFIGURATION
# ============================================

# Webcam device index (0 for default camera, 1 for external, etc.)
WEBCAM_INDEX=0

# Frame width for webcam capture
FRAME_WIDTH=640

# Frame height for webcam capture
FRAME_HEIGHT=480

# FPS for video capture
FPS=30

# ============================================
# MODEL DOWNLOAD CONFIGURATION (OPTIONAL)
# ============================================

# URL to download pre-trained model (if available)
# Leave empty if training from scratch
PRETRAINED_MODEL_URL=

# Google Drive ID for model download (if using Google Drive)
# Example: https://drive.google.com/file/d/YOUR_FILE_ID/view
GDRIVE_MODEL_ID=

# ============================================
# TRAINING CONFIGURATION
# ============================================

# Enable GPU acceleration (true/false)
USE_GPU=true

# Random seed for reproducibility
RANDOM_SEED=42

# Validation split ratio (0.0 to 1.0)
VALIDATION_SPLIT=0.2

# Early stopping patience (epochs)
EARLY_STOPPING_PATIENCE=10

# Model checkpoint save path
CHECKPOINT_PATH=checkpoints/

# Save best model only (true/false)
SAVE_BEST_ONLY=true

# ============================================
# DATA AUGMENTATION
# ============================================

# Enable data augmentation (true/false)
USE_DATA_AUGMENTATION=true

# Rotation range for augmentation (degrees)
ROTATION_RANGE=10

# Width shift range (fraction of total width)
WIDTH_SHIFT_RANGE=0.1

# Height shift range (fraction of total height)
HEIGHT_SHIFT_RANGE=0.1

# Horizontal flip (true/false)
HORIZONTAL_FLIP=true

# Zoom range
ZOOM_RANGE=0.1

# ============================================
# LOGGING CONFIGURATION
# ============================================

# Enable verbose logging (0=silent, 1=progress bar, 2=one line per epoch)
VERBOSE=1

# Log directory for TensorBoard
LOG_DIR=logs/

# Save training history to file (true/false)
SAVE_HISTORY=true

# ============================================
# DEPLOYMENT CONFIGURATION (OPTIONAL)
# ============================================

# API host for deployment
API_HOST=0.0.0.0

# API port for deployment
API_PORT=5000

# Enable debug mode (true/false)
DEBUG=false

# ============================================
# PATHS TO EXTERNAL RESOURCES
# ============================================

# Kaggle credentials (for dataset download)
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key

# Dataset download link (if using external source)
# DATASET_URL=https://www.kaggle.com/datasets/msambare/fer2013

# ============================================
# NOTES
# ============================================
# 1. Paths can be absolute or relative to the project root
# 2. Boolean values should be: true/false (lowercase)
# 3. Numeric values should not have quotes
# 4. String values can optionally have quotes
# 5. Comments start with #
# 6. Never commit the .env file to version control
